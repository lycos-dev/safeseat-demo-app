{
  "expo": {
    "name": "safeseat-app",
    "slug": "safeseat-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safeseatapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101322",
    "ios": {
      "bundleIdentifier": "com.ollymt.safeseatapp",
      "backgroundColor": "#101322",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "SafeSeat uses the local vehicle network to communicate with the Main Hub at 192.168.4.1.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocationWhenInUseUsageDescription": "SafeSeat uses this phone's location during a confirmed driver emergency so registered emergency contacts can receive the current GPS coordinates."
      }
    },
    "android": {
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#101322",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ollymt.safeseatapp",
      "softwareKeyboardLayoutMode": "resize",
      "backgroundColor": "#101322",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "./plugins/with-android-queries",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101322",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SafeSeat to use this phone's location during a confirmed driver emergency so registered emergency contacts can receive the current GPS coordinates."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a76f9721-7bac-4e27-81bd-8e2d86093a52"
      }
    },
    "owner": "lycos"
  }
}
