# ============================================================================
# SafeSeat Emergency SMS Server — Vercel environment variables
# ============================================================================
# NEVER place these secrets in the Expo/mobile .env or in Firestore.

# Keep true while testing. Set false only for the live defense SMS test.
TEST_MODE=true

# TextBee server-side credential. Create/rotate it in the TextBee dashboard.
TEXTBEE_API_KEY=REDACTED

# Optional. If omitted, TextBee uses the account default / most recently active
# enabled Android gateway device. Set this only when you want to pin one device.
TEXTBEE_DEVICE_ID=

# Existing Firebase Admin service account JSON, single-line JSON.
FIREBASE_SERVICE_ACCOUNT=REDACTED
